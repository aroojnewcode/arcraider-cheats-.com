---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import WhySetupSection from '../components/WhySetupSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ContentSections from '../components/ContentSections.astro';
import { resolvePageSeo } from '../config/seo';
import { organizationSchema, websiteSchema } from '../utils/schema';
import { PRIMARY_HERO_IMAGE } from '../config/media';
import { webpSrc } from '../utils/responsiveImage';

const seo = resolvePageSeo('/');
const heroLcpImage = webpSrc(PRIMARY_HERO_IMAGE, 512);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[websiteSchema(), organizationSchema()]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroLcpImage}
    type="image/webp"
    media="(min-width: 1024px)"
    fetchpriority="high"
  />
  <HeroSection heroTitle="Arc Raiders Hacks" />
  <FeaturesSection />
  <ProductsSection />
  <WhySetupSection />
  <ContentSections />
</BaseLayout>
