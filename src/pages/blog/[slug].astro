---
import '../../styles/blog-pages.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';
import { getAllBlogSlugs, getBlogPost, getRelatedBlogPosts } from '../../data/blog';
import { normalizeDocumentTitle, pageTitle, resolvePageSeo } from '../../config/seo';
import { getPageSeoEntry } from '../../config/pageSeo';
import {
  articleSchema,
  breadcrumbSchema,
  parseBlogDate,
} from '../../utils/schema';
import { checkoutPath, resolveCheckoutHref } from '../../config/checkout';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
import BlogPostTopBar from '../../components/BlogPostTopBar.astro';
import { getBlogFaqs } from '../../data/faq';
import SiteFaqSection from '../../components/SiteFaqSection.astro';
import Icon from '../../components/icons/Icon.astro';
import type { BlogBlock } from '../../data/blog';
import { Badge } from '@/components/starwind/badge';
import { Button } from '@/components/starwind/button';
import { Prose } from '@/components/starwind/prose';
import BlogPostCta from '../../components/BlogPostCta.astro';
import { normalizeInternalPath, ROUTES } from '../../utils/path';
import { getBlogCheckoutLabel } from '../../config/blogCheckoutLabels';

export function getStaticPaths() {
  return getAllBlogSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = getBlogPost(slug!);

if (!post) {
  return Astro.redirect('/blog/');
}

const postPath = `/blog/${post.slug}/`;
const seoEntry = getPageSeoEntry(postPath);
const layoutTitle = seoEntry?.title
  ? normalizeDocumentTitle(seoEntry.title)
  : pageTitle(post.title);
const layoutDescription = seoEntry?.description ?? post.desc;
const articleH1 = seoEntry?.h1 ?? post.title;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
  { name: post.title, path: postPath },
];

const related = getRelatedBlogPosts(post.slug, 3);
const checkoutNavLabel = getBlogCheckoutLabel(post.slug);
const productsNavLabel =
  post.slug === 'console-tips' ? 'Open live-server tier picker' : 'Browse Arc Raiders hack tiers';
const blogIndexNavLabel =
  post.slug === 'console-tips' ? 'More practice-to-live articles' : 'More checkout walkthrough articles';

function linkify(text: string): string {
  return text
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_match, label: string, href: string) => {
      const normalized = normalizeInternalPath(href);
      return `<a href="${normalized}">${label}</a>`;
    })
    .replace(/(https:\/\/(?:arcraiderhacks\.com|www\.arcraiderhacks\.com)[^\s.,;)]*)/g, (_match, url: string) => {
      const path = url.replace(/^https:\/\/(?:www\.)?arcraiderhacks\.com/, '');
      const normalized = normalizeInternalPath(path);
      const href = normalized.startsWith('http') ? normalized : `https://arcraiderhacks.com${normalized}`;
      return `<a href="${href}">${url}</a>`;
    });
}

function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}
const published = parseBlogDate(post.date);
---

<BaseLayout
  title={layoutTitle}
  description={layoutDescription}
  ogType="article"
  ogImage={post.image ?? undefined}
  ogImageAlt={post.title}
  articlePublishedTime={published}
  articleModifiedTime={published}
  jsonLd={[
    articleSchema({
      name: post.title,
      description: post.desc,
      url: postPath,
      image: post.image,
      datePublished: published,
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <article class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />

      <BlogPostTopBar post={post} class="mt-6" />

      <div class="blog-article__layout mt-4 grid gap-6 lg:grid-cols-[minmax(14rem,16.5rem)_minmax(0,1fr)] lg:items-start lg:gap-8 xl:grid-cols-[17.5rem_minmax(0,1fr)]">
        <div class="min-w-0 lg:col-start-2 lg:row-start-1">
          {
            post.image ? (
              <figure class="blog-article__hero">
                <ResponsiveImage
                  src={post.image}
                  alt={`${post.title} — Arc Raiders hacks guide cover`}
                  width={960}
                  height={540}
                  loading="eager"
                  fetchPriority="high"
                  sizes="(min-width: 768px) 720px, 100vw"
                  class="w-full object-cover"
                />
                <figcaption class="sr-only">
                  Arc Raiders hacks guide cover for {post.title}. Shop Lite, Pro or Elite at arcraiderhacks.com.
                </figcaption>
              </figure>
            ) : null
          }

          <header class="blog-article__header">
            <h1 class="blog-article__title">{articleH1}</h1>
            <p class="blog-article__lead">{post.desc}</p>
            {
              post.author && (
                <p class="blog-article__byline">
                  <Icon name="users" size={14} />
                  {post.author}
                </p>
              )
            }
          </header>

          <Prose class="blog-article__prose prose-headings:scroll-mt-24 max-w-none text-left">
            {post.body.map((block: BlogBlock) => {
              if (block.type === 'h2') {
                const id = slugify(block.text);
                return <h2 id={id}>{block.text}</h2>;
              }
              if (block.type === 'h3') {
                const id = slugify(block.text);
                return <h3 id={id}>{block.text}</h3>;
              }
              if (block.type === 'ul') {
                return (
                  <ul>
                    {block.items.map((item) => (
                      <li set:html={linkify(item)} />
                    ))}
                  </ul>
                );
              }
              if (block.type === 'table') {
                return (
                  <div class="overflow-x-auto">
                    <table>
                      <thead>
                        <tr>
                          {block.headers.map((header) => (
                            <th>{header}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {block.rows.map((row) => (
                          <tr>
                            {row.map((cell) => (
                              <td set:html={linkify(cell)} />
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                );
              }
              if (block.type === 'cta') {
                return (
                  <BlogPostCta
                    title={block.title}
                    html={linkify(block.text)}
                    href={resolveCheckoutHref(block.href)}
                  />
                );
              }
              return <p set:html={linkify(block.text)} />;
            })}
          </Prose>

          <nav class="blog-article__actions" aria-label="Continue reading">
            <Button as="a" href={checkoutPath('arcRaider')} variant="primary" aria-label={t.ui.checkoutAria}>
              {checkoutNavLabel}
              <Icon name="arrowRight" size={17} />
            </Button>
            <Button as="a" href={ROUTES.products} variant="outline">
              {productsNavLabel}
            </Button>
            <Button as="a" href={ROUTES.blog} variant="outline">
              {blogIndexNavLabel}
              <Icon name="arrowRight" size={17} />
            </Button>
          </nav>
        </div>

        <BlogSidebar post={post} related={related} class="lg:col-start-1 lg:row-start-1" />
      </div>
    </div>
  </article>

  <SiteFaqSection
    items={getBlogFaqs(post.tag, post.slug)}
    titleId={`blog-faq-${post.slug}`}
    class="border-t border-border bg-muted/20"
  />
</BaseLayout>
