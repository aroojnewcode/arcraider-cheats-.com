# Copy to `.env` for local builds, or set the same keys in Cloudflare Pages / Workers **Build** environment.

# Canonical site URL (must match Google Search Console property and live custom domain)
SITE_ORIGIN=https://arcraiderhacks.com
SITEMAP_ORIGIN=https://arcraiderhacks.com

# IndexNow — random hex key; also served at https://arcraiderhacks.com/<INDEXNOW_KEY>.txt after build
# INDEXNOW_KEY=
# INDEXNOW_HOST=arcraiderhacks.com

# Analytics
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Organization schema sameAs (comma-separated). Defaults to PUBLIC_DISCORD_URL / Discord invite when unset.
# PUBLIC_ORG_SAME_AS=https://discord.gg/Vu85F8auQS
# PUBLIC_DISCORD_URL=https://discord.gg/Vu85F8auQS

# Social cards
# PUBLIC_TWITTER_SITE=@arcraiderhacks
# PUBLIC_TWITTER_CREATOR=@arcraiderhacks
