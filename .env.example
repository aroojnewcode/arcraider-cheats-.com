# Copy to `.env` for local builds, or set the same keys in Cloudflare Pages / Workers **Build** environment.

# Canonical site URL (must match Google Search Console property and live custom domain)
SITE_ORIGIN=https://arcraiderhacks.com
SITEMAP_ORIGIN=https://arcraiderhacks.com

# IndexNow — random key; verified at https://arcraiderhacks.com/<INDEXNOW_KEY>.txt after build
# Set both in Cloudflare Build env for production pings (scripts/indexnow.mjs postbuild).
# INDEXNOW_KEY=your-random-key-here
# INDEXNOW_HOST=arcraiderhacks.com

# Google Analytics 4 — injected in BaseLayout when set at build time
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Organization schema sameAs (comma-separated URLs). Optional social profiles:
# PUBLIC_ORG_SAME_AS=https://x.com/arcraiderhacks,https://www.youtube.com/@arcraiderhacks
# Defaults to PUBLIC_DISCORD_URL / Discord invite when unset.
# PUBLIC_ORG_SAME_AS=https://discord.gg/Vu85F8auQS
# PUBLIC_DISCORD_URL=https://discord.gg/Vu85F8auQS

# Social cards
# PUBLIC_TWITTER_SITE=@arcraiderhacks
# PUBLIC_TWITTER_CREATOR=@arcraiderhacks
